# WorldAmaze Environment Variables Example
# Copy this file to .env and fill in the values

GROQ_API_KEY=
GNEWS_API_KEY=
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
RESEND_API_KEY=

# Optional Configuration
# Database URL (defaults to sqlite:///./worldamaze.db if not provided, or PostgreSQL connection string)
DATABASE_URL=
# Application Secret Key for session signing / cookies
SECRET_KEY=
# Environment mode (development / production)
ENVIRONMENT=development
# Resend verified sender email address (e.g., alerts@worldamaze.com or onboarding@resend.dev)
RESEND_FROM_EMAIL=
# Polling interval in minutes (default: 30)
DEFAULT_POLLING_INTERVAL_MINUTES=30
